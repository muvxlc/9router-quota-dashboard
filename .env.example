APP_ORIGIN=https://quota.example.com
UPSTREAM_BASE_URL=https://router.bangkhan.com
BIND_IP=172.16.32.91

# MAXPLUS billing origin (scheme + host only: no path, query, or credentials).
# Use the API subdomain: https://api.maxplus-ai.cc (docs: maxplus-ai.cc/docs/api)
MAXPLUS_BASE_URL=
# MAXPLUS API key: ccsk- followed by exactly 64 hex chars, created at /dashboard.
# A 9router key (router.bangkhan.com) is a different credential and is rejected.
MAXPLUS_API_KEY=
# Leave either value empty to render the money cards as "not configured"
# instead of failing the page.
